{
  "info": {
    "_postman_id": "todo-api-flutter-lesson",
    "name": "Todo API - Flutter Lesson",
    "description": "API Collection for Flutter HTTP Networking lesson.\n\nStudents can test the Todo API endpoints using this collection.\n\n**How to use:**\n1. Set your `appKey` in the Variables tab (e.g., your name)\n2. Test each endpoint\n\n**Endpoints:**\n- GET: Fetch your todos\n- POST: Add new todo\n- PATCH: Update todo status\n- DELETE: Remove todo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Todos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todos?app_key=eq.{{appKey}}&order=created_at.desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ],
          "query": [
            {
              "key": "app_key",
              "value": "eq.{{appKey}}",
              "description": "Filter by your app_key"
            },
            {
              "key": "order",
              "value": "created_at.desc",
              "description": "Sort by newest first"
            }
          ]
        },
        "description": "Fetch all todos for your app_key.\n\n**Query Parameters:**\n- `app_key=eq.{your_key}` - Filter by your key\n- `order=created_at.desc` - Sort newest first"
      },
      "response": []
    },
    {
      "name": "Add Todo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Prefer",
            "value": "return=representation",
            "type": "text",
            "description": "Return the created record"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"app_key\": \"{{appKey}}\",\n    \"title\": \"Learn Flutter HTTP\",\n    \"is_done\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        },
        "description": "Create a new todo item.\n\n**Request Body:**\n```json\n{\n    \"app_key\": \"your_key\",\n    \"title\": \"Your todo text\",\n    \"is_done\": false\n}\n```"
      },
      "response": []
    },
    {
      "name": "Update Todo (Toggle Done)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "apikey",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Prefer",
            "value": "return=representation",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"is_done\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todos?id=eq.{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ],
          "query": [
            {
              "key": "id",
              "value": "eq.{{todoId}}",
              "description": "ID of the todo to update"
            }
          ]
        },
        "description": "Update a todo's status.\n\n**URL Parameter:**\n- `?id=eq.{todo_id}` - Specify which todo to update\n\n**Request Body:**\n```json\n{\n    \"is_done\": true\n}\n```"
      },
      "response": []
    },
    {
      "name": "Update Todo Title",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "apikey",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Prefer",
            "value": "return=representation",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Updated title here\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todos?id=eq.{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ],
          "query": [
            {
              "key": "id",
              "value": "eq.{{todoId}}",
              "description": "ID of the todo to update"
            }
          ]
        },
        "description": "Update a todo's title.\n\n**Request Body:**\n```json\n{\n    \"title\": \"New title\"\n}\n```"
      },
      "response": []
    },
    {
      "name": "Delete Todo",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "apikey",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todos?id=eq.{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ],
          "query": [
            {
              "key": "id",
              "value": "eq.{{todoId}}",
              "description": "ID of the todo to delete"
            }
          ]
        },
        "description": "Delete a todo by ID.\n\n**URL Parameter:**\n- `?id=eq.{todo_id}` - Specify which todo to delete"
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
